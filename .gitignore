# --- Salida de compilacion -------------------------------------------------
# Las clases se generan con compilar.bat / compilar-pruebas.bat; no tiene
# sentido versionarlas.
WEB-INF/classes/
build/
*.class

# --- Librerias ---------------------------------------------------------------
# El conector de MySQL ya viene en C:\xampp\tomcat\lib
WEB-INF/lib/*.jar

# --- Fotos subidas por los usuarios ------------------------------------------
# ArchivoUtil las guarda aqui con un nombre generado (UUID); no son fuente del
# proyecto y no tiene sentido versionarlas. La carpeta se conserva con
# .gitkeep para que exista al clonar, aunque este vacia.
img/propiedades/*
!img/propiedades/.gitkeep

# --- Documentos de las solicitudes -------------------------------------------
# Cedulas, extractos y certificados que suben los clientes: son datos
# personales y nunca deben llegar al repositorio. La carpeta la crea
# ArchivoUtil la primera vez que se sube un documento.
WEB-INF/documentos/

# --- Sobrante de una version anterior ----------------------------------------
# Copia vieja del sitio en HTML plano (index.html, login.html y duplicados de
# css/img/js) dentro de un proyecto que ya se llama "inmobiliaria".
# Queda fuera del repositorio; borrarla del disco es tarea del Sprint 2.
/inmobiliaria/

# --- Configuracion del IDE ---------------------------------------------------
# Eclipse / JDT Language Server: es configuracion de la maquina de cada quien,
# no del proyecto. Se regenera sola al abrir la carpeta.
.project
.classpath
.settings/
.vscode/
.idea/
*.iml

# --- Tomcat ------------------------------------------------------------------
work/
logs/
temp/

# --- Sistema operativo -------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# --- Temporales --------------------------------------------------------------
*.log
*.bak
*~
# Archivo de bloqueo que crea Word mientras un .docx esta abierto
~$*
