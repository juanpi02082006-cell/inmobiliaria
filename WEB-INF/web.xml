<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="false">

    <display-name>Santander Raiz - Inmobiliaria</display-name>

    <!--
        metadata-complete="false" es importante: deja que Tomcat lea las
        anotaciones @WebServlet y @WebFilter de las clases del proyecto.
        Por eso aqui no hace falta declarar los servlets ni el filtro.
    -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- La sesion expira a los 30 minutos de inactividad. -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- La cookie de sesion no debe ser accesible desde JavaScript. -->
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!--
        Paginas de error: el usuario final nunca debe ver una traza de Java.
    -->
    <error-page>
        <error-code>403</error-code>
        <location>/acceso-denegado.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>
