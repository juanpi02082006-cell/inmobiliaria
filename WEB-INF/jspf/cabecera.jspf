<%--
    cabecera.jspf  -  Fragmento reutilizable de encabezado.

    El enunciado pide separacion en capas con JSPF. Este fragmento centraliza
    la barra de navegacion para no repetirla en cada panel.

    El menu se arma dinamicamente segun el rol, pero eso es solo comodidad
    visual: quien decide el acceso de verdad es AutenticacionFilter, en el
    servidor. Ocultar un enlace aqui no protege nada.

    Antes de incluirlo, la pagina debe definir la variable "titulo".
--%>
<%@ page import="com.inmobiliaria.modelo.Usuario" %>
<%@ page import="com.inmobiliaria.controlador.LoginServlet" %>
<%--
    Este import queda disponible en TODAS las paginas del sitio, porque un
    include estatico se fusiona antes de traducir la JSP y las directivas
    page valen para la unidad completa.

    Html.esc() escapa el texto que escribieron las personas. Sin el, un titulo
    o un nombre de perfil con etiquetas HTML se ejecuta en el navegador de
    quien abra la pagina.
--%>
<%@ page import="com.inmobiliaria.util.Html" %>
<%
    Usuario usuarioSesion = (Usuario) session.getAttribute(LoginServlet.USUARIO_EN_SESION);
    String ctx = request.getContextPath();
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= Html.esc((request.getAttribute("titulo") == null) ? "Santander Raiz" : request.getAttribute("titulo")) %></title>

    <!-- Bootstrap 5: cumple el requisito de framework responsivo del enunciado -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Identidad de la marca. Va DESPUES de Bootstrap para poder redefinir
         sus variables de color. Al cargarse desde aqui, todas las paginas
         comparten la misma paleta.

         El "?v=" al final es para romper el cache del navegador: Tomcat no
         manda Cache-Control en los archivos estaticos, asi que un navegador
         puede quedarse con la version vieja del CSS despues de editarlo. Se
         usa la fecha de modificacion del propio archivo como version: cambia
         sola cada vez que se edita el CSS, sin tocar este fragmento. -->
    <link href="<%= ctx %>/css/santander-raiz.css?v=<%=
        new java.io.File(application.getRealPath("/css/santander-raiz.css")).lastModified()
    %>" rel="stylesheet">
</head>
<body class="bg-body-tertiary d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark sr-navbar shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="<%= ctx %>/index.jsp">
            <img src="<%= ctx %>/img/logo-icono.png" alt="">
            Santander Ra&iacute;z
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuPrincipal">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/index.jsp">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/catalogo">Propiedades</a>
                </li>

<%-- ---------------- Menu segun el rol ---------------- --%>
<%      if (usuarioSesion != null) { %>
<%          if (usuarioSesion.tieneRol("ADMIN")) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/panel/admin.jsp">
                        <i class="bi bi-shield-lock me-1"></i>Administracion
                    </a>
                </li>
<%          } %>
<%          if (usuarioSesion.tieneRol("INMOBILIARIA")) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/panel/inmobiliaria.jsp">
                        <i class="bi bi-house-gear me-1"></i>Mis propiedades
                    </a>
                </li>
<%          } %>
<%          if (usuarioSesion.tieneRol("CLIENTE")) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/panel/cliente.jsp">
                        <i class="bi bi-person-check me-1"></i>Mi cuenta
                    </a>
                </li>
<%          } %>
<%      } %>
            </ul>

<%-- ---------------- Sesion ---------------- --%>
<%      if (usuarioSesion == null) { %>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="<%= ctx %>/login.jsp">Iniciar sesion</a>
                <a class="btn btn-primary btn-sm rounded-pill px-3" href="<%= ctx %>/registro.jsp">Registrarse</a>
            </div>
<%      } else { %>
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-lg-flex align-items-center gap-2 sr-navbar-usuario">
                    <span class="sr-navbar-avatar"><i class="bi bi-person-fill"></i></span>
                    <div class="lh-sm">
                        <div class="text-white small fw-semibold mb-1"><%= Html.esc(usuarioSesion.nombreVisible()) %></div>
                        <span class="sr-badge-rol sr-badge-rol-sm <%=
                                usuarioSesion.tieneRol("ADMIN") ? "rol-admin"
                              : usuarioSesion.tieneRol("INMOBILIARIA") ? "rol-inmobiliaria"
                              : usuarioSesion.tieneRol("CLIENTE") ? "rol-cliente"
                              : "rol-visitante" %>">
                            <span class="sr-punto"></span><%= usuarioSesion.rolPrincipal() %>
                        </span>
                    </div>
                </div>
                <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="<%= ctx %>/logout">
                    <i class="bi bi-box-arrow-right me-1"></i>Salir
                </a>
            </div>
<%      } %>
        </div>
    </div>
</nav>

<main class="container py-4 flex-grow-1">
