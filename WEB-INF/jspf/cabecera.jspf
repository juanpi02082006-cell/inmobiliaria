<%--
    cabecera.jspf  -  Fragmento reutilizable de encabezado.

    El enunciado pide separacion en capas con JSPF. Este fragmento centraliza
    la barra de navegacion para no repetirla en cada panel.

    El menu se arma dinamicamente segun el rol, pero eso es solo comodidad
    visual: quien decide el acceso de verdad es AutenticacionFilter, en el
    servidor. Ocultar un enlace aqui no protege nada.

    Antes de incluirlo, la pagina debe definir la variable "titulo".
--%>
<%@ page import="com.inmobiliaria.modelo.Usuario" %>
<%@ page import="com.inmobiliaria.controlador.LoginServlet" %>
<%
    Usuario usuarioSesion = (Usuario) session.getAttribute(LoginServlet.USUARIO_EN_SESION);
    String ctx = request.getContextPath();
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= (request.getAttribute("titulo") == null) ? "Santander Raiz" : request.getAttribute("titulo") %></title>

    <!-- Bootstrap 5: cumple el requisito de framework responsivo del enunciado -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body class="bg-body-tertiary d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="<%= ctx %>/index.jsp">
            <i class="bi bi-buildings me-1"></i>Santander Raiz
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuPrincipal">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/index.jsp">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/propiedades.jsp">Propiedades</a>
                </li>

<%-- ---------------- Menu segun el rol ---------------- --%>
<%      if (usuarioSesion != null) { %>
<%          if (usuarioSesion.tieneRol("ADMIN")) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/panel/admin.jsp">
                        <i class="bi bi-shield-lock me-1"></i>Administracion
                    </a>
                </li>
<%          } %>
<%          if (usuarioSesion.tieneRol("INMOBILIARIA")) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/panel/inmobiliaria.jsp">
                        <i class="bi bi-house-gear me-1"></i>Mis propiedades
                    </a>
                </li>
<%          } %>
<%          if (usuarioSesion.tieneRol("CLIENTE")) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/panel/cliente.jsp">
                        <i class="bi bi-person-check me-1"></i>Mi cuenta
                    </a>
                </li>
<%          } %>
<%      } %>
            </ul>

<%-- ---------------- Sesion ---------------- --%>
<%      if (usuarioSesion == null) { %>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-light btn-sm" href="<%= ctx %>/login.jsp">Iniciar sesion</a>
                <a class="btn btn-primary btn-sm" href="<%= ctx %>/registro.jsp">Registrarse</a>
            </div>
<%      } else { %>
            <div class="d-flex align-items-center gap-3">
                <span class="text-white-50 small d-none d-lg-inline">
                    <i class="bi bi-person-circle me-1"></i><%= usuarioSesion.nombreVisible() %>
                    <span class="badge text-bg-secondary ms-1"><%= usuarioSesion.rolPrincipal() %></span>
                </span>
                <a class="btn btn-outline-light btn-sm" href="<%= ctx %>/logout">Salir</a>
            </div>
<%      } %>
        </div>
    </div>
</nav>

<main class="container py-4 flex-grow-1">
